{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "bg",
					"color": "#FDF8F0",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#FFFCF5",
					"name": "Surface"
				},
				{
					"slug": "surface-2",
					"color": "#F5EDDC",
					"name": "Surface 2"
				},
				{
					"slug": "hero-bg",
					"color": "#006D6A",
					"name": "Hero bg"
				},
				{
					"slug": "border-base",
					"color": "#DDD0B8",
					"name": "Border"
				},
				{
					"slug": "border-light",
					"color": "#EDE5D0",
					"name": "Border (light)"
				},
				{
					"slug": "text-strong",
					"color": "#1A1008",
					"name": "Text (strong)"
				},
				{
					"slug": "text-body",
					"color": "#2E1C0A",
					"name": "Body text"
				},
				{
					"slug": "text-muted",
					"color": "#6B4F2E",
					"name": "Muted text"
				},
				{
					"slug": "text-faint",
					"color": "#8B6940",
					"name": "Text faint"
				},
				{
					"slug": "text-on-dark",
					"color": "#FDF8F0",
					"name": "Text on dark"
				},
				{
					"slug": "text-muted-on-dark",
					"color": "#C8F0ED",
					"name": "Text muted on dark"
				},
				{
					"slug": "accent",
					"color": "#B5411F",
					"name": "Accent"
				},
				{
					"slug": "accent-dark",
					"color": "#A83A1A",
					"name": "Accent dark"
				},
				{
					"slug": "accent-light",
					"color": "#FDE8DE",
					"name": "Accent light"
				},
				{
					"slug": "accent-hover",
					"color": "#A83A1A",
					"name": "Accent hover"
				},
				{
					"slug": "marigold",
					"color": "#D4840A",
					"name": "Marigold"
				},
				{
					"slug": "marigold-light",
					"color": "#FFF3D0",
					"name": "Marigold light"
				},
				{
					"slug": "teal",
					"color": "#006D6A",
					"name": "Teal"
				},
				{
					"slug": "teal-dark",
					"color": "#005250",
					"name": "Teal dark"
				},
				{
					"slug": "teal-light",
					"color": "#D0EFEE",
					"name": "Teal light"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Abril Fatface",
					"slug": "display",
					"fontFamily": "\"Abril Fatface\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Abril Fatface",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/abril-fatface-latin-400-normal.woff2"
							]
						}
					]
				},
				{
					"name": "Nunito",
					"slug": "body",
					"fontFamily": "\"Nunito\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Nunito",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Nunito",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-latin-700-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				},
				{
					"slug": "huge",
					"name": "Display",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text-body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2.5rem)",
				"right": "clamp(1.25rem, 4vw, 2.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--text-strong)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-dark)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--bg)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.02em"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"width": "2px",
							"color": "var(--wp--preset--color--accent)"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--accent-dark)"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.5rem",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text-strong)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [],
	"title": "Comal"
}
